add_validation(
label = "Age Above 24",
columns = "age",
rule = "Age should not exceed 24 years",
check = greater_than(40)
) %>%
add_validation(
label = "Enrollment Outside Range",
columns = "date_enrolled",
rule = "Enrollment date should be between 2024 dates",
check = between_dates(
